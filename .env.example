# Google Cloud & Gemini Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Cartesia TTS Configuration
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_MODEL=sonic-multilingual

# DeepSpeech / STT Configuration
DEEPSPEECH_MODEL_PATH=
DEEPSPEECH_SCORER_PATH=

# Server / Network Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

# Voice Activity Detection (VAD) Settings
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=0.5
VAD_SAMPLE_RATE=16000

# Observability & Logging
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGS=true

# Mock Mode Configuration (Default true for instant local execution without paid APIs)
ENABLE_MOCK_STT=true
ENABLE_MOCK_LLM=true
ENABLE_MOCK_TTS=true

# Post-call & Telephony Settings
RECORDINGS_DIR=outputs/audio
TRANSCRIPTS_DIR=outputs/transcripts
METRICS_DIR=outputs/metrics
REPORTS_DIR=outputs/reports
ENABLE_POST_CALL_ANALYSIS=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ENABLE_ASYNC_QUEUE=false
